# Copie para .env e ajuste. Nada aqui é obrigatório.
SEXTA_CITY_NAME=Lowell, MA
SEXTA_LATITUDE=42.6334
SEXTA_LONGITUDE=-71.3162
SEXTA_TIMEZONE=America/New_York
# Símbolo:id-do-CoinGecko, separados por vírgula
SEXTA_COINS=BTC:bitcoin,ETH:ethereum,POL:polygon-ecosystem-token,UNI:uniswap,DOT:polkadot,LINK:chainlink
# Chave gratuita do plano Demo do CoinGecko (opcional, mas recomendada)
COINGECKO_API_KEY=
# Atualização em segundos (CoinGecko Demo: 10 mil chamadas/mês)
SEXTA_WEATHER_TTL=3600
SEXTA_CRYPTO_TTL=1800
SEXTA_USDTBRL_TTL=1800
# IA local (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
SEXTA_CHAT_MODEL=qwen3:8b
SEXTA_VISION_MODEL=qwen2.5vl:7b
# Whisper: large-v3-turbo (GPU) ou small/medium (mais leves)
SEXTA_WHISPER_MODEL=large-v3-turbo
